package templates

import (
	"fmt"
	"github.com/fedevilensky/a2-test-runner/models"
	"github.com/fedevilensky/a2-test-runner/templates/components"
)

const indexStatic1 = `<style>
      :root {
        --bg: #f7f7f9;
        --surface: #fff;
        --border: #ddd;
        --text: #1a1a1a;
        --muted: #555;
        --th: #f2f2f4;
        --row-border: #ececec;
        --metric: #fafafa;
        --metric-border: #e6e6e6;
        --pre: #f5f5f5;
        --link: #1a6fb5;
        --sidebar: #ebebef;
      }
      [data-theme="dark"] {
        --bg: #18181b;
        --surface: #27272a;
        --border: #3f3f46;
        --text: #e4e4e7;
        --muted: #a1a1aa;
        --th: #333;
        --row-border: #3f3f46;
        --metric: #333;
        --metric-border: #52525b;
        --pre: #1e1e21;
        --link: #60a5fa;
        --sidebar: #1f1f22;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html,
      body {
        height: 100%;
      }
      body {
        display: flex;
        font-family: "Helvetica Neue", Arial, sans-serif;
        color: var(--text);
        background: var(--bg);
        font-size: 14px;
      }
      a {
        color: var(--link);
        text-decoration: none;
      }
      h1 {
        font-size: 1.3rem;
        margin-bottom: 14px;
      }
      h2 {
        font-size: 1.05rem;
        margin-bottom: 8px;
      }
      #sidebar {
        width: 220px;
        background: var(--sidebar);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow: hidden;
      }
      #sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 14px;
        border-bottom: 1px solid var(--border);
        font-weight: 700;
        flex-shrink: 0;
      }
      #sidebar-nav {
        flex: 1;
        overflow-y: auto;
        padding: 6px;
      }
      .nav-link {
        display: block;
        padding: 5px 10px;
        border-radius: 6px;
        color: var(--text);
        font-size: 13px;
        margin-bottom: 1px;
      }
      .nav-link:hover,
      .nav-link.active {
        background: var(--th);
      }
      .nav-link.active {
        font-weight: 600;
      }
      .nav-sep {
        border: none;
        border-top: 1px solid var(--border);
        margin: 5px 2px;
      }
      #main {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        min-width: 0;
      }
      .page {
        display: none;
      }
      .page.active {
        display: block;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 14px;
      }
      .exercise-card {
        padding: 0;
      }
      .exercise-header {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--surface);
        border-radius: 10px;
        padding: 16px;
        cursor: pointer;
      }
      .exercise-toggle {
        display: block;
        background: none;
        border: 0;
        padding: 0;
        color: inherit;
        font: inherit;
        font-size: 1.05rem;
        font-weight: 700;
        text-align: left;
        cursor: pointer;
      }
      .exercise-toggle::before {
        content: "▾ ";
      }
      .exercise-toggle[aria-expanded="false"]::before {
        content: "▸ ";
      }
      .exercise-header .ex-stats {
        margin: 8px 0 0;
      }
      .exercise-content {
        padding: 0 16px 16px;
      }
      .metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(100px, 1fr));
        gap: 8px;
        margin-top: 10px;
      }
      .metric {
        background: var(--metric);
        border: 1px solid var(--metric-border);
        border-radius: 8px;
        padding: 7px 10px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
      }
      th,
      td {
        border-bottom: 1px solid var(--row-border);
        padding: 7px 8px;
        text-align: left;
        vertical-align: top;
      }
      th {
        background: var(--th);
        font-weight: 600;
      }
      .ok {
        color: #0f7a34;
        font-weight: 700;
      }
      .fail {
        color: #b11f1f;
        font-weight: 700;
      }
      pre {
        white-space: pre;
        font-size: 11px;
        line-height: 1.4;
        max-height: calc(10 * 1.4em + 12px);
        overflow: auto;
        background: var(--pre);
        border-radius: 6px;
        padding: 6px;
      }
      .diff-line {
        display: block;
        min-height: 1.4em;
      }
      .diff-removed {
        background: #dceee0;
      }
      .diff-added {
        background: #f5dede;
      }
      [data-theme="dark"] .diff-removed {
        background: #294b35;
      }
      [data-theme="dark"] .diff-added {
        background: #593335;
      }
      .empty-output {
        color: var(--muted);
        font-style: italic;
      }
      .table-scroll {
        overflow-x: auto;
      }
      .table-scroll table {
        table-layout: fixed;
        min-width: 960px;
      }
      .table-scroll td {
        overflow-wrap: anywhere;
      }
      @media (max-width: 700px) {
        #sidebar {
          width: 140px;
        }
        #main {
          padding: 12px;
        }
        .metrics {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .ex-stats {
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 6px;
      }
      .chart-wrap {
        max-width: 700px;
        margin-top: 6px;
      }
      .fit-summary {
        font-size: 12px;
        line-height: 1.45;
      }
      .fit-summary p {
        margin: 6px 0;
      }
      .fit-caveat {
        color: var(--muted);
      }
      .allpass {
        color: #0f7a34;
        font-weight: 700;
      }
      .partial {
        color: #b07800;
        font-weight: 700;
      }
      .allfail {
        color: #b11f1f;
        font-weight: 700;
      }
      .compile {
        color: #7a1fb0;
        font-weight: 700;
      }
      .missing {
        color: #888;
        font-weight: 700;
      }
      .tc {
        text-align: center;
      }
      #theme-toggle {
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 3px 8px;
        cursor: pointer;
        color: var(--text);
        font-size: 13px;
      }
    </style>`
const indexStatic2 = `<script>
      var _cc={};
      document.querySelectorAll("canvas[data-chart]").forEach(function(c){
        _cc[c.id]=JSON.parse(c.dataset.chart);
      });
      var _ci={};
      function _ic(el){
        el.querySelectorAll('canvas').forEach(function(c){
          if(!_ci[c.id]&&_cc[c.id]){_ci[c.id]=new Chart(c,_cc[c.id]);}
        });
      }
      function nav(id,el){
        document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});
        document.querySelectorAll('.nav-link').forEach(function(l){l.classList.remove('active');});
        var pg=document.getElementById(id);
        if(pg){pg.classList.add('active');_ic(pg);}
        if(el)el.classList.add('active');
        history.replaceState(null,'','#'+id);
        document.getElementById('main').scrollTop=0;
        return false;
      }

      (function syncComparisonScroll() {
        var programmatic = new WeakMap();
        document.querySelectorAll('tr').forEach(function(row) {
          var panes = row.querySelectorAll('.compare-output');
          if (panes.length !== 2) return;
          panes.forEach(function(pane, index) {
            pane.addEventListener('scroll', function() {
              var last = programmatic.get(pane);
              if (last && pane.scrollTop === last.top && pane.scrollLeft === last.left) {
                programmatic.delete(pane);
                return;
              }
              programmatic.delete(pane);
              var other = panes[1 - index];
              other.scrollTop = pane.scrollTop;
              other.scrollLeft = pane.scrollLeft;
              programmatic.set(other, {top: other.scrollTop, left: other.scrollLeft});
            });
          });
        });
      }());
      function toggleExercise(button){
        var expanded=button.getAttribute("aria-expanded")==="true";
        button.setAttribute("aria-expanded",String(!expanded));
        button.closest(".exercise-card").querySelector(".table-scroll").hidden=expanded;
      }
      function toggleTheme(){
        var n=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';
        document.documentElement.setAttribute('data-theme',n);
        try{localStorage.setItem('theme',n);}catch(e){}
        document.getElementById('theme-toggle').textContent=n==='dark'?'☀️':'🌙';
      }
      document.getElementById('theme-toggle').textContent=
        document.documentElement.getAttribute('data-theme')==='dark'?'☀️':'🌙';
      (function(){
        var h=location.hash.slice(1)||'summary';
        nav(h,document.querySelector('[href="#'+h+'"]'));
      }());
      window.addEventListener('popstate',function(){
        var h=location.hash.slice(1)||'summary';
        nav(h,document.querySelector('[href="#'+h+'"]'));
      });
    </script>`

templ IndexReport(data models.SPAData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>Test Results</title>
			@components.ThemeInit()
			<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
			@templ.Raw(indexStatic1)
		</head>
		<body>
			<div id="sidebar">
				<div id="sidebar-header">
					<span>Test Results</span>
					@components.ThemeButton()
				</div>
				<nav id="sidebar-nav">
					<a
						class="nav-link"
						href="#summary"
						onclick="return nav('summary', this);"
					>&#128202; Summary</a>
					<hr class="nav-sep"/>
					for _, student := range data.Students {
						<a
							class="nav-link"
							href={ templ.SafeURL("#" + student.ID) }
							onclick="return nav(this.getAttribute('href').slice(1),this)"
						>{ student.StudentName }</a>
					}
				</nav>
			</div>
			<div id="main">
				<div id="summary" class="page">
					<h1>Summary by Exercise</h1>
					<div class="card">
						@components.SummaryTable(data.Summary.Rows, false)
					</div>
				</div>
				for _, student := range data.Students {
					<div id={ student.ID } class="page">
						<h1>{ student.StudentName }</h1>
						<div class="card">
							<div><strong>Path:</strong> { student.StudentPath }</div>
							<div><strong>Started:</strong> { student.StartedAt.String() }</div>
							<div><strong>Finished:</strong> { student.FinishedAt.String() }</div>
							<div class="metrics">
								<div class="metric"><strong>Total:</strong> { student.Total }</div>
								<div class="metric">
									<strong>Passed:</strong> { student.Passed } ({ percent(student.Passed, student.Total) })
								</div>
								<div class="metric">
									<strong>Failed:</strong> { student.Failed } ({ percent(student.Failed, student.Total) })
								</div>
								<div class="metric">
									<strong>Compile/Runtime/Diff:</strong>
									{ student.CompileFails }/{ student.RuntimeFails }/{ student.DiffFails }
								</div>
							</div>
						</div>
						for _, group := range student.Groups {
							@components.Exercise(group, fmt.Sprintf("chart-%s-%d", student.ID, group.Exercise))
						}
					</div>
				}
			</div>
			@templ.Raw(indexStatic2)
		</body>
	</html>
}
