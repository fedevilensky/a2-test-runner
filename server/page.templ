package server

import "github.com/fedevilensky/a2-test-runner/templates/components"

templ page() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Test runner</title>
			@components.ThemeInit()
			<link rel="stylesheet" href="/page.css"/>
			<script src="/app.js" defer></script>
		</head>
		<body>
			<aside aria-label="Report index">
				<h2>Test runner</h2>
				<button type="button" id="show-setup">Run setup</button>
				<a href="#run-summary" id="show-summary" hidden>Results summary</a>
				<nav aria-label="Saved reports">
					<h2>Reports</h2>
					<a href="/reports" data-report="/reports">Combined report</a>
					<a href="/static/summary/" data-report="/static/summary/">Summary</a>
					<div id="results">Loading…</div>
				</nav>
				<h2>Progress</h2>
				<p id="message" role="alert" class="error"></p>
				<div class="progress-card">
					<div class="progress-top">
						<span id="progress-label">Ready</span>
						<span id="progress-percent">0%</span>
					</div>
					<progress
						class="progress-track"
						id="progress-bar"
						value="0"
						max="1"
						aria-label="Run progress"
					></progress>
					<div class="progress-meta" id="progress-counts">0 / 0 steps · 0 / 0 students</div>
					<p class="progress-activity" id="progress-activity" aria-live="polite">No run in progress.</p>
					<details><summary>Run log</summary><pre id="progress-log"></pre></details>
				</div>
			</aside>
			<main>
				<div id="setup">
					<div class="row"><h1 class="wide">Test runner</h1>@components.ThemeButton()</div>
					<p class="muted">Run tests and browse saved results.</p>
					@testsSection()
					@studentsSection()
					@buildSection()
					@runSection()
					@summarySection()
				</div>
				<div id="report-panel" hidden>
					<iframe id="report-frame" title="Test report"></iframe>
				</div>
			</main>
		</body>
	</html>
}

templ testsSection() {
	<section>
		<h2>Tests folder</h2>
		<div class="row">
			<input class="wide" id="tests" type="text" placeholder="Path to tests folder"/>
			<button type="button" data-browse="tests">Choose folder</button>
			<button id="scan-tests" type="button">Scan folder</button>
		</div>
		<div class="drop" id="tests-drop">
			Drop a tests folder here or upload a copy:
			<label>
				<input id="tests-upload" type="file" webkitdirectory directory multiple/>
				choose a folder to upload
			</label>
		</div>
	</section>
}

templ studentsSection() {
	<section>
		<h2>Students</h2>
		<label for="base">Find folders by base path and pattern</label>
		<div class="row">
			<input class="wide" id="base" type="text" placeholder="Base path"/>
			<button type="button" data-browse="base">Choose folder</button>
			<input id="pattern" type="text" value="*" aria-label="Folder pattern"/>
			<button id="discover" type="button">Scan folders</button>
		</div>
		<label for="student-path">Add an individual folder</label>
		<div class="row">
			<input class="wide" id="student-path" type="text" placeholder="Student folder path"/>
			<button type="button" data-browse="student-path">Choose folder</button>
			<button id="add-student" type="button">Add</button>
		</div>
		<div class="drop" id="students-drop">
			Drop student folders here or upload a copy:
			<label>
				<input id="students-upload" type="file" webkitdirectory directory multiple/>
				choose a folder to upload
			</label>
		</div>
		<p class="muted">
			Select the folders to run. Expand a student to override the global build settings.
		</p>
		<div id="students"></div>
	</section>
}

templ buildSection() {
	<section>
		<h2>Build settings</h2>
		<div class="row">
			<div>
				<label for="standard">C++ standard</label>
				<select id="standard">
					<option>c++11</option>
					<option>c++14</option>
					<option>c++17</option>
					<option>c++20</option>
					<option>c++23</option>
				</select>
			</div>
			<div>
				<label for="optimization">Optimization</label>
				<select id="optimization">
					<option value="">Compiler default</option>
					<option>-O0</option>
					<option>-O1</option>
					<option>-O2</option>
					<option>-O3</option>
					<option>-Os</option>
				</select>
			</div>
			<div class="wide">
				<label for="extra">Additional flags (one argument per line)</label>
				<textarea
					id="extra"
					rows="2"
					style="width:100%;box-sizing:border-box"
					placeholder="-Wall"
				></textarea>
			</div>
		</div>
	</section>
}

templ runSection() {
	<section>
		<h2>Run selection</h2>
		<label for="timeout">Timeout per test (seconds)</label>
		<input id="timeout" type="number" min="1" max="86400" step="1" value="30"/>
		<label>
			<input id="incremental" type="checkbox"/>
			Reuse unchanged passing results (incremental run)
		</label>
		<p class="muted">
			Leave unchecked to force all selected tests to run.
			Select exercises or expand an exercise to choose individual input files.
		</p>
		<div id="selection" aria-live="polite">Choose a tests folder to see its exercises.</div>
		<p><button class="primary" id="run" type="button">Run selected students</button></p>
	</section>
}

templ summarySection() {
	<section id="run-summary" hidden>
		<h2>Results summary</h2>
		<h3>Per student</h3>
		<div class="table-scroll">
			<table class="summary-table">
				<thead>
					<tr>
						<th>Student</th>
						<th>Total</th>
						<th>Passed</th>
						<th>Failed</th>
						<th>Compile</th>
						<th>Runtime</th>
						<th>Diff</th>
						<th>Missing</th>
					</tr>
				</thead>
				<tbody id="student-summary"></tbody>
			</table>
		</div>
		<h3>Summary by exercise</h3>
		<div class="table-scroll">
			<table class="summary-table">
				<thead>
					<tr>
						<th>Exercise</th>
						<th>Students</th>
						<th>All pass</th>
						<th>Partial</th>
						<th>All fail</th>
						<th>Compile fail</th>
						<th>Not submitted</th>
					</tr>
				</thead>
				<tbody id="exercise-summary"></tbody>
			</table>
		</div>
	</section>
}
